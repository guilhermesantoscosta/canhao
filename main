<script type="importmap">
{
  "imports": {
    "three": "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js",
    "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/"
  }
}
</script>

<script type="module">
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

/* ═══════════════ CONFIG E ESTADO ═══════════════ */
const CFG = {
  maxX: 42,
  speedX: 4.5,
  ballR: 0.42,
  holeR: 1.05,
  trailMax: 400,
  trailMinDist: 0.09,
  fieldRadius: 60
};

const state = {
  a: -0.08, b: 1.20, c: 0.50,
  phase: 'aim',
  t: 0, hit: false,
  score: 0, attempts: 0,
  targetX: 15,
  sinkT: 0
};

const f = x => state.a * x * x + state.b * x + state.c;
const nf = (n, d = 2) => n.toFixed(d).replace('.', ',');
const $ = id => document.getElementById(id);

const isMobile = () => window.matchMedia('(max-width:820px), (max-height:520px)').matches;

/* ═══════════════ CENA ═══════════════ */
const scene = new THREE.Scene();

const camera = new THREE.PerspectiveCamera(48, innerWidth / innerHeight, 0.1, 500);

const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: 'high-performance' });
renderer.setPixelRatio(Math.min(devicePixelRatio, isMobile() ? 2 : 2));
renderer.setSize(innerWidth, innerHeight);
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.05;
document.body.appendChild(renderer.domElement);

const controls = new OrbitControls(camera, renderer.domElement);
controls.enableDamping = true;
controls.dampingFactor = isMobile() ? 0.12 : 0.08;
controls.maxPolarAngle = Math.PI * 0.495;
controls.minDistance = 8;
controls.maxDistance = 90;
// Touch: 1 dedo gira, 2 dedos dão pan/zoom — comportamento padrão, mas mais suave
controls.rotateSpeed = 0.9;
controls.zoomSpeed = 0.9;
controls.panSpeed = 0.8;

/* Ajusta câmera dependendo do dispositivo e orientação */
function adjustCamera() {
  const w = innerWidth, h = innerHeight;
  const aspect = w / h;

  if (isMobile() && h > w) {
    // Retrato em celular — câmera mais alta e FOV maior
    camera.fov = 62;
    camera.position.set(10, 19, 46);
    controls.target.set(14, 5, 0);
  } else if (isMobile() && w > h) {
    // Paisagem em celular
    camera.fov = 58;
    camera.position.set(6, 15, 40);
    controls.target.set(13, 4.5, 0);
  } else if (aspect < 1.3) {
    // Tablet / janela estreita
    camera.fov = 54;
    camera.position.set(5, 14, 36);
    controls.target.set(12, 4, 0);
  } else {
    // Desktop padrão
    camera.fov = 48;
    camera.position.set(4, 12, 32);
    controls.target.set(12, 3.5, 0);
  }
  camera.updateProjectionMatrix();
  controls.update();
}
adjustCamera();

/* ═══════════════ CÉU COM HORIZONTE ESVERDEADO ═══════════════ */
const skyGeo = new THREE.SphereGeometry(260, 48, 24);
const skyMat = new THREE.ShaderMaterial({
  uniforms: {
    zenithColor:  { value: new THREE.Color(0x1a5ac4) },
    midColor:     { value: new THREE.Color(0x88c0f0) },
    horizonColor: { value: new THREE.Color(0xa9d99a) },
    hazeColor:    { value: new THREE.Color(0xc8e0b8) },
    offset:       { value: 30.0 }
  },
  vertexShader: `
    varying vec3 vWorldPosition;
    void main() {
      vec4 wp = modelMatrix * vec4(position, 1.0);
      vWorldPosition = wp.xyz;
      gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
    }`,
  fragmentShader: `
    uniform vec3 zenithColor;
    uniform vec3 midColor;
    uniform vec3 horizonColor;
    uniform vec3 hazeColor;
    uniform float offset;
    varying vec3 vWorldPosition;
    void main() {
      float h = normalize(vWorldPosition + vec3(0.0, offset, 0.0)).y;
      float t1 = smoothstep(0.25, 1.0, h);
      vec3 sky = mix(midColor, zenithColor, t1);
      float t2 = smoothstep(0.0, 0.22, h);
      vec3 horizonBand = mix(horizonColor, midColor, t2);
      float t3 = smoothstep(-0.15, 0.05, h);
      vec3 lower = mix(hazeColor, horizonBand, t3);
      vec3 col = (h < 0.15) ? lower : mix(horizonBand, sky, smoothstep(0.15, 0.4, h));
      gl_FragColor = vec4(col, 1.0);
    }`,
  side: THREE.BackSide,
  depthWrite: false
});
scene.add(new THREE.Mesh(skyGeo, skyMat));

scene.fog = new THREE.Fog(0xa9d99a, 70, 220);

/* --------- Luzes --------- */
scene.add(new THREE.HemisphereLight(0xdff1ff, 0x3a5a2e, 0.95));
const sun = new THREE.DirectionalLight(0xfff4d8, 2.4);
sun.position.set(-25, 38, 28);
sun.castShadow = true;
sun.shadow.mapSize.set(isMobile() ? 1024 : 2048, isMobile() ? 1024 : 2048);
sun.shadow.camera.near = 1;
sun.shadow.camera.far = 150;
sun.shadow.camera.left = -50;
sun.shadow.camera.right = 50;
sun.shadow.camera.top = 50;
sun.shadow.camera.bottom = -50;
sun.shadow.bias = -0.0008;
sun.target.position.set(14, 0, 0);
scene.add(sun, sun.target);

/* ═══════════════ CAMPO ═══════════════ */
function makeFieldTexture() {
  const size = isMobile() ? 1024 : 2048;
  const canvas = document.createElement('canvas');
  canvas.width = canvas.height = size;
  const ctx = canvas.getContext('2d');
  const cx = size / 2, cy = size / 2;
  const maxR = size / 2;
  const unitsRadius = CFG.fieldRadius;
  const pxPerUnit = maxR / unitsRadius;

  ctx.fillStyle = '#1e4a24';
  ctx.fillRect(0, 0, size, size);

  for (let i = 1; i <= unitsRadius; i++) {
    ctx.beginPath();
    ctx.arc(cx, cy, i * pxPerUnit, 0, Math.PI * 2);
    ctx.fillStyle = (i % 2 === 0) ? '#2c6532' : '#1f5026';
    ctx.fill();
  }

  ctx.strokeStyle = 'rgba(200, 240, 200, 0.22)';
  ctx.lineWidth = 2;
  for (let a = 0; a < 360; a += 15) {
    const rad = a * Math.PI / 180;
    ctx.beginPath();
    ctx.moveTo(cx, cy);
    ctx.lineTo(cx + Math.cos(rad) * maxR, cy + Math.sin(rad) * maxR);
    ctx.stroke();
  }

  ctx.strokeStyle = 'rgba(220, 245, 220, 0.28)';
  ctx.lineWidth = 1.3;
  for (let i = 1; i <= unitsRadius; i++) {
    ctx.beginPath();
    ctx.arc(cx, cy, i * pxPerUnit, 0, Math.PI * 2);
    ctx.stroke();
  }

  ctx.strokeStyle = 'rgba(240, 255, 240, 0.55)';
  ctx.lineWidth = 3;
  for (let i = 5; i <= unitsRadius; i += 5) {
    ctx.beginPath();
    ctx.arc(cx, cy, i * pxPerUnit, 0, Math.PI * 2);
    ctx.stroke();
  }

  ctx.strokeStyle = 'rgba(255, 255, 255, 0.65)';
  ctx.lineWidth = 6;
  ctx.beginPath();
  ctx.arc(cx, cy, maxR - 2, 0, Math.PI * 2);
  ctx.stroke();

  const tex = new THREE.CanvasTexture(canvas);
  tex.colorSpace = THREE.SRGBColorSpace;
  tex.anisotropy = renderer.capabilities.getMaxAnisotropy();
  return tex;
}

const fieldTex = makeFieldTexture();
const fieldGeo = new THREE.CircleGeometry(CFG.fieldRadius, isMobile() ? 64 : 128);
const fieldMat = new THREE.MeshStandardMaterial({ map: fieldTex, roughness: 1, metalness: 0 });
const field = new THREE.Mesh(fieldGeo, fieldMat);
field.rotation.x = -Math.PI / 2;
field.position.set(0, 0.02, 0);
field.receiveShadow = true;
scene.add(field);

const outerGround = new THREE.Mesh(
  new THREE.PlaneGeometry(600, 600),
  new THREE.MeshStandardMaterial({ color: 0x2d5c2f, roughness: 1 })
);
outerGround.rotation.x = -Math.PI / 2;
outerGround.position.set(0, -0.05, 0);
outerGround.receiveShadow = true;
scene.add(outerGround);

/* ═══════════════ CANHÃO ═══════════════ */
const matDark  = new THREE.MeshStandardMaterial({ color: 0x2c3d5e, metalness: .5, roughness: .55 });
const matMetal = new THREE.MeshStandardMaterial({ color: 0x9aabc8, metalness: .85, roughness: .28 });
const matAccent = new THREE.MeshStandardMaterial({ color: 0x6fa8ff, emissive: 0x2a4b8a, emissiveIntensity: 0.8, metalness: .5, roughness: .3 });

const pedestal = new THREE.Mesh(new THREE.CylinderGeometry(0.32, 0.5, 1, 18), matDark);
pedestal.castShadow = true;
scene.add(pedestal);

const pivot = new THREE.Mesh(new THREE.SphereGeometry(0.32, 16, 12), matAccent);
pivot.castShadow = true;
scene.add(pivot);

const barrel = new THREE.Mesh(new THREE.CylinderGeometry(0.22, 0.30, 1.8, 22), matMetal);
barrel.castShadow = true;
scene.add(barrel);

const muzzle = new THREE.Mesh(new THREE.TorusGeometry(0.24, 0.045, 8, 20), matAccent);
muzzle.castShadow = false;
scene.add(muzzle);

function updateLauncher() {
  const c = state.c;
  const h = Math.max(c, 0.2);
  pedestal.scale.set(1, h, 1);
  pedestal.position.set(0, h / 2, 0);
  pivot.position.set(0, c, 0);

  const theta = Math.atan(state.b);
  const dir = new THREE.Vector3(Math.cos(theta), Math.sin(theta), 0);
  const L = 1.8;
  barrel.rotation.z = theta - Math.PI / 2;
  barrel.position.set(0, c, 0).addScaledVector(dir, L / 2);
  muzzle.position.set(0, c, 0).addScaledVector(dir, L);
  muzzle.rotation.y = Math.PI / 2;
  muzzle.rotation.z = theta;
}

/* --------- Bolinha --------- */
const ballMat = new THREE.MeshStandardMaterial({
  color: 0xfff2b0, emissive: 0xffaa22, emissiveIntensity: 1.2,
  roughness: .25, metalness: .15
});
const ball = new THREE.Mesh(new THREE.SphereGeometry(CFG.ballR, 28, 20), ballMat);
ball.castShadow = true;
scene.add(ball);

/* ═══════════════ RASTRO ═══════════════ */
const trailGroup = new THREE.Group();
scene.add(trailGroup);

const trailGeo = new THREE.SphereGeometry(0.14, 8, 6);
const trailMat = new THREE.MeshBasicMaterial({ color: 0xffc233, transparent: true, opacity: 0.9 });

const trailPool = [];
for (let i = 0; i < CFG.trailMax; i++) {
  const m = new THREE.Mesh(trailGeo, trailMat);
  m.visible = false;
  m.frustumCulled = false;
  trailGroup.add(m);
  trailPool.push(m);
}
let trailHead = 0;

function pushTrail(x, y, z) {
  const last = trailPool[(trailHead - 1 + CFG.trailMax) % CFG.trailMax];
  if (last.visible) {
    const dx = x - last.position.x, dy = y - last.position.y, dz = z - last.position.z;
    if (dx*dx + dy*dy + dz*dz < CFG.trailMinDist * CFG.trailMinDist) return;
  }
  const m = trailPool[trailHead];
  m.position.set(x, y, z);
  m.visible = true;
  trailHead = (trailHead + 1) % CFG.trailMax;
}
function clearTrail() {
  for (const m of trailPool) m.visible = false;
  trailHead = 0;
}

/* ═══════════════ BURACO ═══════════════ */
const holeGroup = new THREE.Group();
scene.add(holeGroup);

const holeFloor = new THREE.Mesh(
  new THREE.CircleGeometry(CFG.holeR, 40),
  new THREE.MeshBasicMaterial({ color: 0x02040a, transparent: true, opacity: 0.95 })
);
holeFloor.rotation.x = -Math.PI / 2;
holeFloor.position.y = 0.04;
holeGroup.add(holeFloor);

const holeWall = new THREE.Mesh(
  new THREE.CylinderGeometry(CFG.holeR, CFG.holeR, 0.4, 40, 1, true),
  new THREE.MeshBasicMaterial({ color: 0x050912, side: THREE.BackSide, transparent: true, opacity: 0.9 })
);
holeWall.position.y = -0.18;
holeGroup.add(holeWall);

const rimMat = new THREE.MeshStandardMaterial({
  color: 0x30e3ca, emissive: 0x11a08c, emissiveIntensity: 1.3,
  metalness: .6, roughness: .28
});
const rim = new THREE.Mesh(new THREE.TorusGeometry(CFG.holeR, 0.11, 14, 56), rimMat);
rim.rotation.x = -Math.PI / 2;
rim.position.y = 0.08;
holeGroup.add(rim);

const bullseye = new THREE.Mesh(
  new THREE.CircleGeometry(0.28, 24),
  new THREE.MeshBasicMaterial({ color: 0x30e3ca, transparent: true, opacity: 0.55 })
);
bullseye.rotation.x = -Math.PI / 2;
bullseye.position.y = 0.06;
holeGroup.add(bullseye);

const flagPole = new THREE.Mesh(
  new THREE.CylinderGeometry(0.055, 0.055, 3, 8),
  matMetal
);
flagPole.castShadow = true;
flagPole.position.set(CFG.holeR + 0.35, 1.5, 0);
holeGroup.add(flagPole);

const flagMesh = new THREE.Mesh(
  new THREE.PlaneGeometry(0.95, 0.6),
  new THREE.MeshBasicMaterial({ color: 0xff6b9d, side: THREE.DoubleSide })
);
flagMesh.position.set(CFG.holeR + 0.35 + 0.5, 2.55, 0);
holeGroup.add(flagMesh);

function placeTarget(x) {
  state.targetX = x;
  holeGroup.position.set(x, 0, 0);
  $('tgt').textContent = nf(x, 1) + ' m';
}

/* --------- Marcador do vértice --------- */
const vMarker = new THREE.Mesh(
  new THREE.SphereGeometry(0.23, 16, 12),
  new THREE.MeshBasicMaterial({ color: 0xff2f7a })
);
scene.add(vMarker);

const vLineGeo = new THREE.BufferGeometry().setFromPoints([new THREE.Vector3(), new THREE.Vector3()]);
const vLine = new THREE.Line(vLineGeo, new THREE.LineDashedMaterial({
  color: 0xff2f7a, dashSize: 0.32, gapSize: 0.26, transparent: true, opacity: .9
}));
vLine.frustumCulled = false;
scene.add(vLine);

function updateHelpers() {
  const { a, b, c } = state;
  if (Math.abs(a) > 1e-6) {
    const xv = -b / (2 * a);
    const yv = c - (b * b) / (4 * a);
    vMarker.visible = true;
    vMarker.position.set(xv, yv, 0);
    const p = vLineGeo.attributes.position;
    p.setXYZ(0, xv, 0, 0);
    p.setXYZ(1, xv, Math.max(yv, 0), 0);
    p.needsUpdate = true;
    vLineGeo.computeBoundingSphere();
    vLine.computeLineDistances();
    vLine.visible = true;
  } else {
    vMarker.visible = false;
    vLine.visible = false;
  }
}

/* ═══════════════ HUD ═══════════════ */
function updateHUD() {
  const { a, b, c } = state;
  const delta = b * b - 4 * a * c;

  $('eq').innerHTML =
    `y = ${a < 0 ? '−' : ''}${nf(Math.abs(a), 3)}x² ` +
    `${b < 0 ? '−' : '+'} ${nf(Math.abs(b))}x ` +
    `${c < 0 ? '−' : '+'} ${nf(Math.abs(c))}`;

  $('delta').textContent = nf(delta);

  if (Math.abs(a) < 1e-9) {
    $('vertex').textContent = 'não existe (a = 0)';
    $('roots').textContent  = 'função do 1º grau';
    $('ymax').textContent   = '—';
  } else {
    const xv = -b / (2 * a);
    const yv = c - (b * b) / (4 * a);
    $('vertex').textContent = `(${nf(xv)}, ${nf(yv)})`;
    $('ymax').textContent   = nf(yv) + ' m';

    if (delta < 0) {
      $('roots').textContent = 'nenhuma real (Δ < 0)';
    } else {
      const sq = Math.sqrt(delta);
      const x1 = (-b - sq) / (2 * a);
      const x2 = (-b + sq) / (2 * a);
      $('roots').textContent = `x₁=${nf(x1)} · x₂=${nf(x2)}`;
    }
  }

  const cv = $('concav');
  if (a < -1e-6) {
    cv.className = 'ok';
    cv.innerHTML = 'Concavidade para baixo (a &lt; 0) ✔';
  } else if (a > 1e-6) {
    cv.className = 'bad';
    cv.innerHTML = 'Concavidade para cima (a &gt; 0) ✘';
  } else {
    cv.className = 'bad';
    cv.innerHTML = 'a = 0 → reta, não parábola.';
  }

  $('score').textContent    = state.score;
  $('attempts').textContent = state.attempts;
}

let toastTimer;
function showToast(html, kind) {
  const el = $('toast');
  el.innerHTML = html;
  el.className = 'show ' + kind;
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => { el.className = ''; }, 3400);
}

/* ═══════════════ CONTROLES UI ═══════════════ */
const sA = $('sA'), sB = $('sB'), sC = $('sC');

function onParamsChanged() {
  $('vA').textContent = (state.a < 0 ? '−' : '') + nf(Math.abs(state.a), 3);
  $('vB').textContent = nf(state.b);
  $('vC').textContent = nf(state.c);

  updateHelpers();
  updateHUD();
  updateLauncher();

  if (state.phase === 'aim') ball.position.set(0, state.c, 0);
}

// 'input' cobre touch e mouse
sA.addEventListener('input', () => { state.a = parseFloat(sA.value); onParamsChanged(); });
sB.addEventListener('input', () => { state.b = parseFloat(sB.value); onParamsChanged(); });
sC.addEventListener('input', () => { state.c = parseFloat(sC.value); onParamsChanged(); });

function setPhase(p) {
  state.phase = p;
  const locked = (p !== 'aim');
  [sA, sB, sC].forEach(s => s.disabled = locked);
  $('btnLaunch').disabled = locked;
}

function spawnTarget() {
  const x = Math.round((9 + Math.random() * 15) * 2) / 2;
  placeTarget(x);
}

/* ═══════════════ LÓGICA DO JOGO ═══════════════ */
function launch() {
  if (state.phase !== 'aim') return;
  clearTrail();
  state.t = 0;
  state.hit = false;
  state.sinkT = 0;
  state.attempts++;
  ball.visible = true;
  ball.scale.setScalar(1);
  ball.position.set(0, state.c, 0);
  pushTrail(0, state.c, 0);
  setPhase('flying');
  updateHUD();

  // Vibração de feedback no mobile
  if (navigator.vibrate) navigator.vibrate(30);
}

function stepFlight(dt) {
  state.t += dt;
  const x = CFG.speedX * state.t;
  const y = f(x);

  ball.position.set(x, y, 0);
  pushTrail(x, y, 0);
  $('pos').textContent = nf(x, 1) + ' · ' + nf(y, 1);

  if (y <= 0 && x > 0.5) {
    ball.position.y = 0;
    pushTrail(x, 0, 0);

    const distToHole = Math.abs(x - state.targetX);
    if (distToHole <= CFG.holeR) {
      state.hit = true;
      state.score++;
      hitFlash = 1;
      ball.position.set(state.targetX, 0, 0);
      setPhase('sinking');
      state.sinkT = 0;
      showToast(
        `🎯 <b>Na mosca!</b> A raiz positiva em x = ${nf(state.targetX)} m<br>
         caiu exatamente dentro do buraco. <b>Δ = ${nf(state.b*state.b - 4*state.a*state.c)}</b>`,
        'ok'
      );
      if (navigator.vibrate) navigator.vibrate([40, 30, 60]);
      updateHUD();
      return;
    } else {
      endFlight(false, x);
      return;
    }
  }

  if (x > CFG.maxX) endFlight(false, x);
}

function endFlight(hit, landingX) {
  setPhase('done');

  if (!hit) {
    let msg;
    if (landingX >= CFG.maxX - 0.5) {
      msg = `❌ <b>A bolinha saiu do campo.</b><br>Aumente <b>b</b> ou diminua |a|.`;
    } else {
      const delta = Math.abs(landingX - state.targetX);
      const dir = landingX < state.targetX ? 'antes' : 'depois';
      msg = `❌ <b>Caiu em x = ${nf(landingX)} m</b>, ${nf(delta)} m ${dir} do buraco (x = ${nf(state.targetX)} m).`;
      if (landingX < state.targetX) {
        msg += `<br>Aumente <b>b</b> ou diminua |a|.`;
      } else {
        msg += `<br>Diminua <b>b</b> ou aumente |a|.`;
      }
    }
    showToast(msg, 'bad');
    if (navigator.vibrate) navigator.vibrate(20);
  }

  updateHUD();

  setTimeout(() => {
    if (state.phase !== 'done') return;
    if (hit) spawnTarget();
    resetShot();
  }, hit ? 700 : 1300);
}

function stepSink(dt) {
  state.sinkT += dt;
  ball.position.y = -state.sinkT * 5;
  ball.scale.setScalar(Math.max(0.15, 1 - state.sinkT * 1.6));

  if (state.sinkT > 0.55) {
    ball.visible = false;
    endFlight(true);
  }
}

function resetShot() {
  setPhase('aim');
  state.t = 0;
  state.hit = false;
  state.sinkT = 0;
  ball.visible = true;
  ball.scale.setScalar(1);
  ball.position.set(0, state.c, 0);
  $('pos').textContent = nf(0, 1) + ' · ' + nf(state.c, 1);
  updateLauncher();
  updateHUD();
}

function fullReset() {
  state.score = 0;
  state.attempts = 0;
  clearTrail();
  spawnTarget();
  resetShot();
  $('toast').className = '';
}

/* --------- Botões --------- */
$('btnLaunch').addEventListener('click', launch);
$('btnReset').addEventListener('click', fullReset);
$('btnTarget').addEventListener('click', () => {
  if (state.phase === 'aim') spawnTarget();
});

/* Toggle do painel matemático (mobile) */
$('btnMathToggle').addEventListener('click', () => {
  $('math').classList.toggle('show');
});

/* Fechar painel matemático ao tocar fora dele (em mobile) */
document.addEventListener('touchstart', (e) => {
  if (!isMobile()) return;
  const math = $('math');
  const btn = $('btnMathToggle');
  if (math.classList.contains('show') &&
      !math.contains(e.target) &&
      !btn.contains(e.target)) {
    math.classList.remove('show');
  }
}, { passive: true });

/* --------- Teclado (desktop) --------- */
addEventListener('keydown', e => {
  if (e.code === 'Space') { e.preventDefault(); launch(); }
  if (e.key === 'r' || e.key === 'R') fullReset();
  if (e.key === 'm' || e.key === 'M') $('math').classList.toggle('show');
});

/* --------- Resize / orientação --------- */
let resizeTimer;
addEventListener('resize', () => {
  clearTimeout(resizeTimer);
  resizeTimer = setTimeout(() => {
    camera.aspect = innerWidth / innerHeight;
    adjustCamera();
    renderer.setSize(innerWidth, innerHeight);
  }, 120);
});

// Detecta mudança de orientação no mobile
if (screen.orientation && screen.orientation.addEventListener) {
  screen.orientation.addEventListener('change', () => {
    setTimeout(() => {
      camera.aspect = innerWidth / innerHeight;
      adjustCamera();
      renderer.setSize(innerWidth, innerHeight);
    }, 200);
  });
}

/* ═══════════════ LOOP PRINCIPAL ═══════════════ */
const clock = new THREE.Clock();
let hitFlash = 0;

function animate() {
  requestAnimationFrame(animate);
  const dt = Math.min(clock.getDelta(), 0.05);
  const et = clock.elapsedTime;

  if (state.phase === 'flying')  stepFlight(dt);
  if (state.phase === 'sinking') stepSink(dt);

  let s = 1 + Math.sin(et * 3) * 0.03;
  if (hitFlash > 0) {
    hitFlash = Math.max(0, hitFlash - dt * 1.6);
    s += hitFlash * 0.45;
    rimMat.emissiveIntensity = 1.3 + hitFlash * 5;
    rimMat.color.setHex(hitFlash > 0.02 ? 0x9dfff0 : 0x30e3ca);
  } else {
    rimMat.emissiveIntensity = 1.3;
    rimMat.color.setHex(0x30e3ca);
  }
  holeGroup.scale.setScalar(s);
  holeGroup.rotation.y = et * 0.15;

  flagMesh.rotation.y = Math.sin(et * 4) * 0.35;

  if (state.phase === 'aim') {
    ball.scale.setScalar(1 + Math.sin(et * 4) * 0.08);
  }

  controls.update();
  renderer.render(scene, camera);
}

/* ═══════════════ INICIALIZAÇÃO ═══════════════ */
placeTarget(15);
onParamsChanged();
ball.position.set(0, state.c, 0);
$('pos').textContent = nf(0, 1) + ' · ' + nf(state.c, 1);
animate();
</script>
</body>
</html>
